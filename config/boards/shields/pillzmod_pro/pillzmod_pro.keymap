        default_num {
            bindings = <
            &trans  &trans  &trans         &trans         &trans           &trans  &trans  &trans  &trans          &trans  &trans  &trans &trans  &trans         &trans          &trans          &trans        &trans
            &none   &none   &none          &msc SCRL_UP   &none            &none                                                           &none  &kp KP_NUM     &kp KP_DIVIDE   &kp KP_MULTIPLY &kp KP_EQUAL  &none
            &none   &none   &msc SCRL_LEFT &mmv MOVE_UP   &msc SCRL_RIGHT  &none                                                           &none  &kp KP_N7      &kp KP_N8       &kp KP_N9       &kp KP_MINUS  &none
            &none   &none   &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT  &none                                                           &none  &kp KP_N4      &kp KP_N5       &kp KP_N6       &kp KP_PLUS   &none
            &none   &none   &none          &msc SCRL_DOWN &none            &none                                                           &none  &kp KP_N1      &kp KP_N2       &kp KP_N3       &kp KP_ENTER  &none
                    &none   &none          &none          &none                                                                                   &kp KP_EQUAL   &kp KP_NUMBER_0 &kp KP_DOT      &kp KP_ENTER
                                                                                              &mkp 3  &trans     &trans  &mkp 3
                                                                                                      &trans     &trans
                                                                                      &mkp 1  &mkp 2  &trans     &trans  &mkp 2  &mkp 1
                                                                                                   &trans   &trans   &trans
