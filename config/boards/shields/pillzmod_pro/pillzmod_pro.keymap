        default_mod {
            bindings = <
            &trans      &trans       &trans       &trans       &trans       &trans  &trans  &trans  &trans   &trans  &trans &trans  &trans        &trans        &trans        &trans        &trans        &trans
            &bt BT_CLR  &pfl0        &pfl1        &pfl2        &pfl3        &pfl4                                                   &bt BT_DISC 0 &bt BT_DISC 1  &bt BT_DISC 2 &bt BT_DISC 3 &bt BT_DISC 4 &bt BT_CLR
            &bootloader &none        &none        &none        &none        &none                                                   &none         &none          &none         &none         &none         &bootloader
            &sys_reset  &none        &none        &none        &none        &none                                                   &none         &none          &none         &none         &none         &sys_reset
            &soft_off   &none        &none        &none        &none        &none                                                   &none         &none          &none         &none         &none         &soft_off
                        &none        &none        &none        &none                                                                              &none          &none         &none         &none
                                                                                                &none  &none  &none  &none
                                                                                                        &none  &none
                                                                                        &none  &none  &none  &none  &none  &none
                                                                                                &none   &none   &none
            >;
        };
        default_med {
            bindings = <
            &trans      &trans       &trans       &trans       &trans       &trans  &trans  &trans  &trans   &trans  &trans &trans  &trans        &trans        &trans        &trans        &trans        &trans
            &none &none                &none                  &none              &none                  &none                      &none       &none          &none         &none          &none                &none
            &none &kp C_AL_JOURNAL     &kp C_AL_WORD          &kp C_AL_EMAIL     &kp C_AL_TEXT_EDITOR   &kp C_AL_TASK_MANAGER      &kp C_RW    &kp C_PAUSE    &kp C_PLAY    &kp C_FF       &kp C_STOP_EJECT     &none
            &none &kp C_AL_CALC        &kp C_AL_SHEET         &kp C_AL_DOCS      &kp C_AL_FILES         &kp C_AL_TEXT_EDITOR       &kp C_PREV  &kp C_VOL_DN   &kp C_VOL_UP  &kp C_NEXT     &kp C_MUTE           &none
            &none &kp C_AL_IMAGES      &kp C_AL_CONTROL_PANEL &kp C_AL_CAL       &kp C_AL_MUSIC         &kp C_AL_WWW               &kp C_REC   &kp C_SHUFFLE  &kp C_REPEAT  &kp C_CAPTIONS &kp C_DATA_ON_SCREEN &none
                  &kp C_AL_SELECT_TASK &kp C_AL_HELP          &kp C_AL_PREV_TASK &kp C_AL_NEXT_TASK                                            &kp C_BRI_DN   &kp C_BRI_UP  &kp C_SNAPSHOT &none
                                                                                                                &trans  &trans  &trans  &trans
                                                                                                                        &trans  &trans
                                                                                                        &trans &trans  &trans  &trans  &trans &trans
                                                                                                                &trans   &trans   &trans
            >;
        };
        win_nav {
            bindings = <
        &trans           &trans               &trans             &trans              &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans          &trans          &trans         &trans          &trans
        &kp F11          &kp F1               &kp F2             &kp F3              &kp F4          &kp F5                                                  &kp F6       &kp F7          &kp F8          &kp F9         &kp F10         &kp F12
        &macro_backtick  &kp LA(F4)           &Win_Select_Word   &macro_kill_to_end  &kp LC(BSPC)    &kp LC(HOME)                                            &kp RC(LEFT) &kp RC(DOWN)    &kp RC(UP)      &kp RC(RIGHT)  &none           &macro_block
        &macro_quotes    &macro_kill_to_start &macro_select_line &macro_kill_line    &kp LC(DEL)     &kp LC(A)                                               &kp LEFT     &kp DOWN        &kp UP          &kp RIGHT      &none           &macro_dquotes
        &macro_parens    &Win_Undo            &Win_Cut           &Win_Copy           &Win_Paste      &kp LC(END)                                             &kp HOME     &kp PG_DN       &kp PG_UP       &kp END        &none           &macro_braces
                         &none                &macro_fatarrow    &macro_join_pln     &macro_join_nln                                                                      &macro_open_dln &macro_open_uln &macro_arrow   &none
                                                                                                                        &trans  &trans  &trans  &trans
                                                                                                                                &trans  &trans
                                                                                                                 &trans &trans  &trans  &trans  &trans &trans
                                                                                                                           &trans   &trans   &trans
            >;
        };
        mac_nav {
            bindings = <
        &trans           &trans               &trans             &trans              &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans          &trans          &trans         &trans          &trans
        &kp F11          &kp F1               &kp F2             &kp F3              &kp F4          &kp F5                                                  &kp F6       &kp F7          &kp F8          &kp F9         &kp F10         &kp F12
        &macro_backtick  &kp LG(Q)            &Mac_Select_Word   &macro_kill_to_end  &kp LA(BSPC)    &kp LG(UP)                                              &kp RA(LEFT) &kp RA(DOWN)    &kp RA(UP)      &kp RA(RIGHT)  &none           &macro_block
        &macro_quotes    &macro_kill_to_start &macro_select_line &macro_kill_line    &kp LA(DEL)     &kp LG(A)                                               &kp LEFT     &kp DOWN        &kp UP          &kp RIGHT      &none           &macro_dquotes
        &macro_parens    &Mac_Undo            &Mac_Cut           &Mac_Copy           &Mac_Paste      &kp LG(DOWN)                                            &kp RG(LEFT) &kp PG_DN       &kp PG_UP       &kp RG(RIGHT)  &none           &macro_braces
                         &none                &macro_fatarrow    &macro_join_pln     &macro_join_nln                                                                      &macro_open_dln &macro_open_uln &macro_arrow   &none
                                                                                                                        &trans  &trans  &trans  &trans
                                                                                                                                &trans  &trans
                                                                                                                 &trans &trans  &trans  &trans  &trans &trans
                                                                                                                           &trans   &trans   &trans
            >;
